# Copy to .env and adjust. Values here are read by config/settings.py.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet key used to encrypt API keys (SMS, payments) stored in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes previously saved keys unreadable (re-enter them in the admin page).
FIELD_ENCRYPTION_KEY=

# Comma-separated origins allowed to call the API (the React dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional regexes for extra browser origins, such as a Netlify site.
CORS_ALLOWED_ORIGIN_REGEXES=
# HTTPS origins allowed to use Django admin behind Nginx.
CSRF_TRUSTED_ORIGINS=

# Leave empty to use SQLite. Example: postgres://user:pass@localhost:5432/agrimika
DATABASE_URL=
